# Environment variables for the application
DATABASE_URL="postgresql://USUARIO:PASSWORD@localhost:5433/historias_clinicas?schema=public"

NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="cambia_este_valor_por_un_secreto_largo"

# Zona horaria de operación (por defecto America/Bogota)
NEXT_PUBLIC_APP_TIME_ZONE="America/Bogota"

# Contraseña inicial del usuario "admin" que crea `npm run seed`.
# Si no se define, el seed no crea el usuario administrador.
SEED_ADMIN_PASSWORD=""